rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products: Publicly readable, but not writable by ecommerce users
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Assuming POS or Admin handles this
    }

    // User Profiles: Owners can read and write their own data
    match /shopUsers/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Orders: 
    // - Authenticated users can create orders
    // - Users can read their own orders (filtered by userId)
    match /orders/{orderId} {
      allow create: if true; 
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false; 
    }
  }
}
