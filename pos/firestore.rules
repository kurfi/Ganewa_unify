rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------
    // Helper functions (Purely custom claims based - zero email fallbacks)
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Staff with mustChangePassword flag are blocked from business operations
    function isPasswordChangePending() {
      return isSignedIn() 
        && ('mustChangePassword' in request.auth.token)
        && request.auth.token.mustChangePassword == true;
    }

    function isStaff() {
      return isSignedIn() 
        && !isPasswordChangePending()
        && ('role' in request.auth.token)
        && request.auth.token.role in ['SUPER_ADMIN', 'ADMIN', 'CASHIER'];
    }

    function isAdmin() {
      return isSignedIn() 
        && !isPasswordChangePending()
        && ('role' in request.auth.token)
        && request.auth.token.role in ['SUPER_ADMIN', 'ADMIN'];
    }

    function isSuperAdmin() {
      return isSignedIn() 
        && !isPasswordChangePending()
        && ('role' in request.auth.token)
        && request.auth.token.role == 'SUPER_ADMIN';
    }

    function noCatalogFieldsChanged() {
      return request.resource.data.get('sellPrice', null) == resource.data.get('sellPrice', null)
        && request.resource.data.get('costPrice', null) == resource.data.get('costPrice', null)
        && request.resource.data.get('buyPrice', null) == resource.data.get('buyPrice', null)
        && request.resource.data.get('name', null) == resource.data.get('name', null)
        && request.resource.data.get('barcode', null) == resource.data.get('barcode', null)
        && request.resource.data.get('category', null) == resource.data.get('category', null)
        && request.resource.data.get('categoryId', null) == resource.data.get('categoryId', null)
        && request.resource.data.get('department', null) == resource.data.get('department', null)
        && request.resource.data.get('wholesalePrice', null) == resource.data.get('wholesalePrice', null);
    }

    function isValidSaleDecrement(productId) {
      return ('lastSaleId' in request.resource.data)
        && (request.resource.data.lastSaleId is string)
        && (!('lastSaleId' in resource.data) || request.resource.data.lastSaleId != resource.data.lastSaleId)
        && existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId))
        && ('itemQuantities' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data)
        && (productId in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data.itemQuantities)
        && ('quantity' in resource.data)
        && ('quantity' in request.resource.data)
        && (resource.data.quantity is number)
        && (request.resource.data.quantity is number)
        && request.resource.data.quantity < resource.data.quantity
        && (resource.data.quantity - request.resource.data.quantity) == getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastSaleId)).data.itemQuantities[productId];
    }

    function isValidAuditAdjustment() {
      return ('auditLogId' in request.resource.data)
        && (request.resource.data.auditLogId is string)
        && existsAfter(/databases/$(database)/documents/auditLogs/$(request.resource.data.auditLogId));
    }

    // -------------------------------------------------------------
    // Products:
    // - Publicly readable for storefront catalog.
    // - Only ADMIN and SUPER_ADMIN can create, delete, or edit pricing/catalog fields.
    // - Cashiers CANNOT change price, costPrice, wholesalePrice, barcode, or name.
    // - Stock updates by cashiers are permitted in two safe ways:
    //   (a) A checkout sale: stock decrements occur in the same transaction as the sale
    //       (linked by a saleId attribute on updated_at/metadata, or existing in same commit).
    //   (b) Manual stock count adjustments: allowed only if a corresponding audit record
    //       exists in auditLogs with a non-empty reason.
    // -------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if (
        isAdmin() || (
          isStaff()
          && noCatalogFieldsChanged()
          && (
            isValidSaleDecrement(productId)
            || isValidAuditAdjustment()
          )
        )
      );

      // Sensitive financial / supplier data subcollection:
      // - Readable by staff (for profit reports, purchase modals)
      // - WRITABLE ONLY BY ADMIN and SUPER_ADMIN (cashiers cannot write or tamper)
      match /privateData/{docId} {
        allow read: if isStaff();
        allow write: if isAdmin();
      }
    }

    // Collection-group rule for privateData (required by rules_version = '2' for collectionGroup(db, 'privateData'))
    match /{path=**}/privateData/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // Users collection rules:
    // - SUPER_ADMIN has full access.
    // - Individual staff can read their own profile (matching docId OR matching uid field)
    // - Cashiers are strictly prevented from reading other staff documents,
    //   protecting plaintext passwords while they still exist.
    // - Staff with mustChangePassword can update their own password / doc.
    // -------------------------------------------------------------
    match /users/{docId} { 
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == docId || 
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == docId || 
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create, delete: if isSuperAdmin(); 
    }

    // -------------------------------------------------------------
    // POS Private Collections: Accessible only by staff
    // -------------------------------------------------------------
    match /customers/{docId} { allow read, write: if isStaff(); }
    match /sales/{docId} { allow read, write: if isStaff(); }
    
    // Dedicated heldSales collection: staff only
    match /heldSales/{docId} { allow read, write: if isStaff(); }
    
    match /expenses/{docId} { allow read, write: if isStaff(); }
    match /purchases/{docId} { allow read, write: if isStaff(); }
    match /suppliers/{docId} { allow read, write: if isStaff(); }
    match /returns/{docId} { allow read, write: if isStaff(); }
    match /returnedItems/{docId} { allow read, write: if isStaff(); }
    // Deprecated: kept for backwards compatibility with live POS until migration completes
    match /departments/{docId} { allow read, write: if isStaff(); }
    
    // Categories:
    // - Storefront and public can read active categories only.
    // - Staff can read all categories (including hidden).
    // - Only ADMIN and SUPER_ADMIN can create, update, or delete categories.
    // - Nobody except staff can write.
    match /categories/{categoryId} {
      allow read: if isStaff() || resource.data.active == true;
      allow write: if isAdmin();
    }
    match /cashBook/{docId} { allow read, write: if isStaff(); }
    match /supplierPayments/{docId} { allow read, write: if isStaff(); }
    match /auditLogs/{docId} { allow read, write: if isStaff(); }
    match /stockWriteOffs/{docId} { allow read, write: if isStaff(); }

    // Settings (app config): staff read, strictly controlled write
    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin() && docId != 'invoiceCounter' && docId != 'runningBalance';
    }
    match /settings/invoiceCounter {
      allow read: if isStaff();
      allow write: if false;  // Only writable by Admin SDK / Cloud Functions
    }
    match /settings/runningBalance {
      allow read: if isStaff();
      allow write: if false;  // Only writable by Admin SDK / Cloud Functions
    }

    // Bank Accounts: Customers can read active accounts, staff can manage
    match /bankAccounts/{docId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Daily Stats & Alerts
    match /dailyStats/{docId} {
      allow read: if isStaff();
      allow write: if false;  // Only Cloud Scheduler / Admin SDK
    }
    match /stockAlerts/{docId} {
      allow read, write: if isStaff();
    }
    match /debtDiscrepancies/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Customer Payments (repayments): Customers can read their own, staff can write
    match /customerPayments/{paymentId} {
      allow read: if isSignedIn() && (
        isStaff() || 
        resource.data.customerId == get(/databases/$(database)/documents/shopUsers/$(request.auth.uid)).data.linkedPosCustomerId
      );
      allow write: if isStaff();
    }

    // User Profiles:
    // - Customers can read/create/update their own profile
    // - Customers CANNOT modify or create 'creditInfo', 'linkedPosCustomerId', or 'linkedPosCustomerName'
    // - Staff has full access to sync creditInfo and manage links
    match /shopUsers/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow create: if isSignedIn() && request.auth.uid == userId 
        && (!('creditInfo' in request.resource.data) || request.resource.data.creditInfo == null);
      allow update: if isSignedIn() && (
        isStaff() || (
          request.auth.uid == userId && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creditInfo', 'linkedPosCustomerId', 'linkedPosCustomerName']) ||
            (request.resource.data.linkedPosCustomerId == null &&
             request.resource.data.creditInfo == null)
          )
        )
      );
      allow delete: if isStaff();
      allow list: if isStaff() || request.query.limit == 1;
    }

    // Orders: 
    // - CLIENT CREATION, UPDATE, AND DELETION ARE COMPLETELY FORBIDDEN.
    // - Orders are created exclusively server-side via createOrder Cloud Function (Admin SDK).
    // - Staff can read, update status, and manage orders.
    // - Customers / shoppers can read ONLY their own orders (userId == request.auth.uid).
    match /orders/{orderId} {
      allow create: if false;
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isStaff());
      allow update, delete: if isStaff();
    }

    // Order Idempotency Collection:
    // - Managed exclusively server-side by createOrder Cloud Function.
    // - Client read and write are completely denied.
    match /orderIdempotency/{docId} {
      allow read, write: if false;
    }
  }
}
